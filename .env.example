# Variable NAMES only — never put real values in this file or commit a .env.
# Copy to .env locally and fill in; set the same names in Netlify.

# ── Browser (VITE_) — bundled into the site, so PUBLIC values only ───────────
# Only these five may use the VITE_ prefix. Anything secret must NOT be VITE_.
VITE_GOOGLE_CLIENT_ID=
VITE_MSG91_WIDGET_ID=
# MSG91 widget token (public by design; the widget runs in the browser)
VITE_MSG91_TOKEN_AUTH=
# Razorpay public key id (the key SECRET is server-only, below)
VITE_RAZORPAY_KEY_ID=
# "true" only on localhost for mock mode; never on Netlify
VITE_SERA_MOCK=

# ── Server only (Netlify functions) — secrets, never VITE_, never in src/ ────
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
# Today's single agent (sera-start-call)
RETELL_AGENT_ID=
# One agent per round (screening = Sera, hr = Vinit, final = Arvind)
RETELL_AGENT_ID_SCREENING=
RETELL_AGENT_ID_HR=
RETELL_AGENT_ID_FINAL=
OPENAI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# MSG91 server auth key (verifies the WhatsApp OTP token server-side)
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
YOUTUBE_API_KEY=
SERA_ADMIN_EMAILS=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
