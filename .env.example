# Variable NAMES only — never put real values in this file or commit a .env.
# Copy to .env locally and fill in; set the same names in Netlify.

# ── Browser (VITE_) — bundled into the site, so PUBLIC values only ───────────
# Only these five may use the VITE_ prefix. Anything secret must NOT be VITE_.
VITE_GOOGLE_CLIENT_ID=
VITE_MSG91_WIDGET_ID=
# MSG91 widget token (public by design; the widget runs in the browser)
VITE_MSG91_TOKEN_AUTH=
# Razorpay public key id (the key SECRET is server-only, below)
VITE_RAZORPAY_KEY_ID=
# "true" only on localhost for mock mode; never on Netlify
VITE_SERA_MOCK=

# ── Server only (server/index.js on YZIServer) — secrets, never VITE_, never in src/ ────
# Vapi: ONE squad call for the whole interview (Sera -> Vinit -> Sonia). Server only.
# Vapi's web-call endpoint (POST /call/web) only accepts the PUBLIC key; the private key gets a 401.
# It is used here on the SERVER ONLY. Never VITE_: a key in the browser can start calls from DevTools.
VAPI_PUBLIC_KEY=
# id of the "YZI Interview" squad (from the Vapi dashboard; never committed)
VAPI_SQUAD_ID=
# credential Vapi sends to /api/sera/vapi-webhook (Authorization: Bearer <this>)
VAPI_WEBHOOK_SECRET=
# Vapi PRIVATE key. Only used to read a finished call back after a server restart (GET /call/{id}). Server only.
VAPI_PRIVATE_KEY=
OPENAI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# MSG91 server auth key (verifies the WhatsApp OTP token server-side)
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
YOUTUBE_API_KEY=
SERA_ADMIN_EMAILS=
# Owner alert email for a report that failed twice (sent through the VPS Postfix)
SERA_ALERT_EMAIL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
