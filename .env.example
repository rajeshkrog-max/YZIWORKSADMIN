# Sera login mock mode (localhost only). When "true", the Meet Sera login uses
# fake Google / MSG91 popups and local student codes — no OTP cost, no Google
# setup. Never set this on Netlify. See docs/sera-login-contract.md.
VITE_SERA_MOCK=false

# Razorpay public key id (safe in the browser). Only a fallback — the pay screen
# uses the keyId returned by the server's create-order. NEVER put the key secret
# in any VITE_ variable. See docs/sera-payment-contract.md.
VITE_RAZORPAY_KEY_ID=
